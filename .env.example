# === Telegram ===
# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Faqat shu Telegram user ID'lari botdan foydalana oladi (vergul bilan ajrating).
# O'z ID'ingizni @userinfobot orqali bilib oling.
ALLOWED_TELEGRAM_IDS=123456789

# === AI provayderlar (kamida bittasini to'ldiring) ===
# Panelda generatsiya paytida qaysi birini ishlatishni tanlaysiz.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Groq (console.groq.com) — juda tez va arzon
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral AI (console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# === Instagram ===
# TAVSIYA: login/parolni bo'sh qoldiring va paneldagi "Instagram ulanish"
# bo'limidan brauzeringizdagi sessionid cookie'sini joylang (xavfsizroq).
# Quyidagilar faqat parol orqali kirishni xohlasangiz kerak bo'ladi:
IG_USERNAME=
IG_PASSWORD=
# Sessiya fayli (qayta-qayta login qilmaslik uchun — ban xavfini kamaytiradi)
IG_SESSION_FILE=ig_session.json

# === Xavfsizlik / Rate-limit (ban xavfini kamaytirish uchun) ===
# Ikki komment orasidagi minimal kutish (sekund)
MIN_SECONDS_BETWEEN_COMMENTS=90
# Har komment oldidan tasodifiy qo'shimcha kutish oralig'i (sekund)
RANDOM_DELAY_MIN=4
RANDOM_DELAY_MAX=12
# Bir kunda maksimal komment soni
MAX_COMMENTS_PER_DAY=30

# === Web-panel ===
# Panelga kirish paroli. Bo'sh qoldirsangiz parolsiz ochiladi (faqat lokal sinov uchun).
PANEL_PASSWORD=ParolniBuYergaYozing

# === Avtomatik proxy (IPRoyal residential) ===
# PROXY_AUTO=1 bo'lsa, yangi akkaunt qo'shilganda (proxy maydoni bo'sh bo'lsa) har
# akkauntga avtomatik alohida UZ sticky-IP biriktiriladi va login shu IP orqali o'tadi.
# Parametrlar IPRoyal'da PAROLGA qo'shiladi (kod buni avtomatik bajaradi).
PROXY_AUTO=0
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USER=
PROXY_PASS=
PROXY_COUNTRY=uz
PROXY_LIFETIME=30m

# === Webhook (kiruvchi trigger — tashqi skript/cron) ===
# Bo'sh bo'lsa webhook o'chiq. Tasodifiy uzun token qo'ying.
WEBHOOK_TOKEN=

# Avtomatlashtirish kanali (bot admin bo'lishi shart). @username yoki -100... ID.
TELEGRAM_CHANNEL_ID=
# Telegram botni shu muhitda yoqish (1) / o'chirish (0). Bir token faqat BITTA joyda
# polling qilsin (mini-PC ga ko'chirganda AWS da BOT_ENABLED=0 qiling — aks holda Conflict).
BOT_ENABLED=1
# uvicorn porti (mini-PC da boshqa loyiha bilan to'qnashmasin). Docker konteyner ichi 8000.
PORT=8000
