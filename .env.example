# === Telegram ===
# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Faqat shu Telegram user ID'lari botdan foydalana oladi (vergul bilan ajrating).
# O'z ID'ingizni @userinfobot orqali bilib oling.
ALLOWED_TELEGRAM_IDS=123456789

# === AI provayderlar (kamida bittasini to'ldiring) ===
# Panelda generatsiya paytida qaysi birini ishlatishni tanlaysiz.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Groq (console.groq.com) — juda tez va arzon
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral AI (console.mistral.ai)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# === Instagram ===
# TAVSIYA: login/parolni bo'sh qoldiring va paneldagi "Instagram ulanish"
# bo'limidan brauzeringizdagi sessionid cookie'sini joylang (xavfsizroq).
# Quyidagilar faqat parol orqali kirishni xohlasangiz kerak bo'ladi:
IG_USERNAME=
IG_PASSWORD=
# Sessiya fayli (qayta-qayta login qilmaslik uchun — ban xavfini kamaytiradi)
IG_SESSION_FILE=ig_session.json

# === Xavfsizlik / Rate-limit (ban xavfini kamaytirish uchun) ===
# Ikki komment orasidagi minimal kutish (sekund)
MIN_SECONDS_BETWEEN_COMMENTS=90
# Har komment oldidan tasodifiy qo'shimcha kutish oralig'i (sekund)
RANDOM_DELAY_MIN=4
RANDOM_DELAY_MAX=12
# Bir kunda maksimal komment soni
MAX_COMMENTS_PER_DAY=30

# === Web-panel ===
# Panelga kirish paroli. Bo'sh qoldirsangiz parolsiz ochiladi (faqat lokal sinov uchun).
PANEL_PASSWORD=ParolniBuYergaYozing
